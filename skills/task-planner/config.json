{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "task-planner skill thresholds — all mutable numbers live here",
  "type": "object",
  "properties": {
    "max_vc": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "description": "Minimum Verification Contract items per plan (Std 44)"
    },
    "min_verification_per_phase": {
      "type": "integer",
      "default": 2,
      "minimum": 1,
      "description": "Minimum V-N checks bound to each phase (Std 45)"
    },
    "retry_count": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "description": "Max retries on same V-N FAIL before escalating to user (Std 42)"
    },
    "max_tool_calls_before_refresh": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "description": "Tool calls threshold before re-reading task_plan.md (Std 10)"
    },
    "max_view_browser_before_save": {
      "type": "integer",
      "default": 2,
      "minimum": 1,
      "description": "view/browser/search ops before writing findings.md (Rule 3)"
    },
    "plan_dir_pattern": {
      "type": "string",
      "default": "plans/{task-id}/",
      "description": "Task isolation directory pattern"
    },
    "template_priority": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["project-level", "built-in"],
      "description": "Template search order: project-level first, then built-in fallback"
    },
    "escalation_threshold": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "description": "Consecutive failures before AskUserQuestion escalation (Rule 9)"
    }
  },
  "required": ["max_vc", "min_verification_per_phase", "retry_count", "max_tool_calls_before_refresh", "max_view_browser_before_save"],
  "additionalProperties": false
}

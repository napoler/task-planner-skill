{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan-state.json — task-planner 结构化计划权威源",
  "description": "P1（task-json-state-20261121）：把任务计划从半结构化 Markdown 升级为 JSON 权威源。planctl.py 是唯一写入者，4 个 MD 文件为只读派生视图。模板空串 created_at/updated_at 属未设置合法态（draft-07 format 为 annotation 非 assertion），init 落盘时填 ISO8601。",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "plan_tier",
    "execution_lane",
    "created_at",
    "updated_at",
    "requirements",
    "goals",
    "vcs",
    "phases",
    "findings",
    "audits",
    "delegations",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "plan_tier": { "type": "string", "enum": ["standard", "mini"] },
    "execution_lane": { "type": "string", "enum": ["L0", "L0-T", "L0-E", "L1", "L2"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "requirements": { "type": "array", "items": { "$ref": "#/definitions/requirement" } },
    "goals": { "type": "array", "items": { "$ref": "#/definitions/goal" } },
    "vcs": { "type": "array", "items": { "$ref": "#/definitions/vc" } },
    "phases": { "type": "array", "items": { "$ref": "#/definitions/phase" } },
    "findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "audits": { "type": "array", "items": { "$ref": "#/definitions/audit" } },
    "delegations": { "type": "array", "items": { "$ref": "#/definitions/delegation" } },
    "tags": { "$ref": "#/definitions/tag_list" },
    "actions": { "type": "array", "items": { "$ref": "#/definitions/action_item" } },
    "files": { "type": "array", "items": { "$ref": "#/definitions/file_item" } },
    "test_results": { "type": "array", "items": { "$ref": "#/definitions/test_result_item" } },
    "errors": { "type": "array", "items": { "$ref": "#/definitions/error_item" } },
    "reboot5q": { "type": "array", "items": { "$ref": "#/definitions/reboot5q_item" } },
    "knowledge_use": { "type": "array", "items": { "$ref": "#/definitions/knowledge_use_item" } },
    "resume_report": { "$ref": "#/definitions/resume_report" },
    "research": { "type": "array", "items": { "$ref": "#/definitions/research_item" } },
    "decisions": { "type": "array", "items": { "$ref": "#/definitions/decision_item" } },
    "issues": { "type": "array", "items": { "$ref": "#/definitions/issue_item" } },
    "resources": { "type": "array", "items": { "$ref": "#/definitions/resource_item" } },
    "visual": { "type": "array", "items": { "$ref": "#/definitions/visual_item" } },
    "template_type": { "type": "string" },
    "template_body": { "type": "string", "description": "init 所选 variant 模板正文原文（render 领域段附录数据源；可选，存量 JSON 无此字段照样合法）" },
    "understanding": { "$ref": "#/definitions/understanding" },
    "root_causes": { "type": "array", "items": { "$ref": "#/definitions/root_cause_item" } },
    "invariants": { "type": "array", "items": { "$ref": "#/definitions/invariant_item" } },
    "spec_baseline": { "type": "array", "items": { "$ref": "#/definitions/spec_baseline_item" } },
    "progress_baseline": { "type": "array", "items": { "$ref": "#/definitions/progress_baseline_item" } },
    "config": { "$ref": "#/definitions/config_obj" },
    "dual_qc": { "$ref": "#/definitions/dual_qc" },
    "goal_verdict": { "$ref": "#/definitions/goal_verdict" },
    "scope_limits": { "type": "array", "items": { "$ref": "#/definitions/scope_limit_item" } },
    "changes": { "type": "array", "items": { "$ref": "#/definitions/change_item" } },
    "knowledge": { "type": "array", "items": { "$ref": "#/definitions/knowledge_item" } },
    "core_question": { "$ref": "#/definitions/core_question" },
    "research_status": { "type": "array", "items": { "$ref": "#/definitions/research_status_item" } },
    "evidence_faces": { "type": "array", "items": { "$ref": "#/definitions/evidence_face_item" } },
    "next_step": { "type": "string" },
    "tool_use": { "type": "array", "items": { "$ref": "#/definitions/tool_use_item" } },
    "s_units": { "type": "array", "items": { "$ref": "#/definitions/s_unit_item" } },
    "anti_regress": { "type": "array", "items": { "$ref": "#/definitions/anti_regress_item" } },
    "isolation": { "$ref": "#/definitions/isolation" },
    "fmea": { "type": "array", "items": { "$ref": "#/definitions/fmea_item" } },
    "todo_sync": { "type": "array", "items": { "$ref": "#/definitions/todo_sync_item" } },
    "key_questions": { "type": "array", "items": { "$ref": "#/definitions/key_question_item" } },
    "batch": { "$ref": "#/definitions/batch" },
    "delegation_stats": { "$ref": "#/definitions/delegation_stats" },
    "chain": { "$ref": "#/definitions/chain" },
    "phase_gates": { "type": "array", "items": { "$ref": "#/definitions/phase_gate_item" } },
    "knowledge_compliance": { "type": "array", "items": { "$ref": "#/definitions/knowledge_compliance_item" } },
    "quality_gates": { "$ref": "#/definitions/quality_gates" },
    "outcome": { "$ref": "#/definitions/outcome" },
    "cross_checks": { "type": "array", "items": { "$ref": "#/definitions/cross_check_item" } }
  },
  "definitions": {
    "tag_list": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "requirement": {
      "type": "object",
      "description": "R 行：用户需求逐条抄录；type=目标须映射可观察判据型 VC。",
      "required": ["id", "text", "type", "vc"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["目标", "手段"] },
        "vc": { "type": "array", "items": { "type": "string" } },
        "tags": { "$ref": "#/definitions/tag_list" }
      }
    },
    "goal": {
      "type": "object",
      "description": "goal 单元（Rule 66.1 的 JSON 投影）。",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "tags": { "$ref": "#/definitions/tag_list" },
        "evidence": { "type": "string", "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: goal 证据锚文本（写入 progress.md 的 - [goal:G<n>] 行）; Why: evidence-anchor 门按 [goal:G<n>] 整行取证据,无此字段则 goal 证据无法从 JSON 派生。" },
        "name": { "type": "string", "description": "[2026-11-22 task-planctl-exec-surface-20261122] What: goal 任务名（短名）; Why: render「🎯 Goal 单元表」（Rule 66.5 六列锚）任务名列数据源。" },
        "verify": { "type": "string", "description": "[2026-11-22 task-planctl-exec-surface-20261122] What: goal 完整验证方式（命令/判据文本）; Why: Rule 66.5 完整验证方式列非空门的数据源。" },
        "s_units": { "type": "array", "items": { "type": "string" }, "description": "[2026-11-22 task-planctl-exec-surface-20261122] What: goal 对应 S-unit 引用列表; Why: Rule 66.5 对应 S-unit 列数据源。" },
        "status": { "type": "string", "description": "[2026-11-22 task-planctl-exec-surface-20261122] What: goal 状态（pending/pass/fail 等）; Why: Rule 66.5 状态列数据源。" }
      }
    },
    "vc": {
      "type": "object",
      "description": "Verification Contract 条目；command 由 check vc-nonvacuous 静态判真空。",
      "required": ["id", "criterion", "command", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "criterion": { "type": "string" },
        "command": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "pass", "fail"] },
        "evidence": { "type": "string" },
        "tags": { "$ref": "#/definitions/tag_list" }
      }
    },
    "phase": {
      "type": "object",
      "description": "Phase 条目；v_checks 存映射的 VC 编号，供 check rvc 做 VC→引用兜底。",
      "required": ["id", "status", "s_units", "v_checks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pending", "in_progress", "complete"] },
        "s_units": { "type": "array", "items": { "type": "string" } },
        "v_checks": { "type": "array", "items": { "type": "string" } },
        "tags": { "$ref": "#/definitions/tag_list" },
        "name": { "type": "string", "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Phase 显示名; Why: render `### Phase <id>: <name>` 与模板逐字对齐。" },
        "started": { "type": "string", "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Phase 起始 ISO8601 时间; Why: check-3file-gate.sh 从 progress.md 的 **Started:** 行取 mtime 锚点,必须由 JSON 派生。" }
      }
    },
    "finding": {
      "type": "object",
      "description": "findings 条目；source 为 file:line / URL 等可追溯锚。",
      "required": ["id", "text", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "source": { "type": "string" },
        "tags": { "$ref": "#/definitions/tag_list" }
      }
    },
    "audit": {
      "type": "object",
      "description": "独立审计轮次；check audit 取 round 最大条目判 APPROVED 且 C=0/I=0；issues（2026-11-21 新增，可选）承载显式问题 key 供连续无进展判定，旧条目无 issues 仍合法。",
      "required": ["round", "verdict", "by", "counts", "at"],
      "additionalProperties": false,
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "verdict": { "type": "string", "enum": ["APPROVED", "REJECTED"] },
        "by": { "type": "string" },
        "counts": {
          "type": "object",
          "required": ["C", "I", "W"],
          "additionalProperties": false,
          "properties": {
            "C": { "type": "integer", "minimum": 0 },
            "I": { "type": "integer", "minimum": 0 },
            "W": { "type": "integer", "minimum": 0 }
          }
        },
        "at": { "type": "string", "format": "date-time" },
        "issues": { "type": "array", "items": { "$ref": "#/definitions/audit_issue" } },
        "tags": { "$ref": "#/definitions/tag_list" }
      }
    },
    "audit_issue": {
      "type": "object",
      "description": "审计问题单项（2026-11-21 task-audit-rework-cap-20261121）：key 是跨轮无进展判定的唯一信号源，severity/state 决定该 key 是否为开放 C/I。",
      "required": ["key", "severity", "state"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^(C|I|W|N|Q)-[A-Za-z0-9_\\u4e00-\\u9fff-]{1,48}$" },
        "severity": { "type": "string", "enum": ["C", "I", "W", "N", "Q"] },
        "state": { "type": "string", "enum": ["open", "fixed", "accepted", "new", "deferred"] },
        "title": { "type": "string" }
      }
    },
    "delegation": {
      "type": "object",
      "description": "子代理派发登记（Rule 22.5 的 JSON 投影）。",
      "required": ["id", "agent", "scope", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "agent": { "type": "string" },
        "scope": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "running", "done", "fail"] },
        "tags": { "$ref": "#/definitions/tag_list" }
      }
    },
    "action_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: 动作留痕条目（Rule 19.2）；原行为仅存在于 progress.md 自由文本，无机器可读结构；Why: 全面 JSON 派生后需承载写入。",
      "required": ["id", "phase", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string" },
        "text": { "type": "string" },
        "at": { "type": "string" }
      }
    },
    "file_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Files created/modified 表条目；原行为只在 MD 表格中，无法被机器门消费；Why: 变更留痕入库。",
      "required": ["id", "path", "change"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string" },
        "path": { "type": "string" },
        "change": { "type": "string" }
      }
    },
    "test_result_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Test Results 七列条目；原行为为 MD 表格；Why: 测试证据结构化后可校验 status。",
      "required": ["id", "test", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string" },
        "test": { "type": "string" },
        "input": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "error_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Error Log 七列（Rule 19.4/31）；原行为仅 MD 文本，错误根因无法聚合；Why: 失败复盘入库。attempt 为重试序号（整数），其余为自由文本。",
      "required": ["id", "timestamp", "error"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string" },
        "error": { "type": "string" },
        "attempt": { "type": "integer" },
        "resolution": { "type": "string" },
        "root_cause": { "type": "string" },
        "prevention": { "type": "string" },
        "trigger": { "type": "string" }
      }
    },
    "reboot5q_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: 5-Question Reboot 问答（Rule 67）；原行为为 MD 段落；Why: 统一 id 以复用通用 add/get/set/delete 定位。",
      "required": ["id", "question", "answer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string" },
        "answer": { "type": "string" }
      }
    },
    "knowledge_use_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: 知识储备使用记录；原行为散落于执行叙述；Why: 显式留痕来源与用途。",
      "required": ["id", "source", "purpose"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string" },
        "source": { "type": "string" },
        "purpose": { "type": "string" }
      }
    },
    "resume_report": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: plan-resume 报告锚（path/last）；原行为由脚本另读路径文件；Why: 锚点入权威源，视图重建可直接消费。",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "last": { "type": "string" }
      }
    },
    "research_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Research Findings 三列（Rule 71 无源不写）；原行为仅 findings.md 文本；Why: source 必填使无源断言无法入库。",
      "required": ["id", "claim", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "decision_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Technical Decisions（决策+理由）；原行为为 MD 段落；Why: 决策可追溯、可被裁决门引用。",
      "required": ["id", "decision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "decision": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "issue_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Issues Encountered；原行为为 MD 列表；Why: 问题与处置入结构化源。",
      "required": ["id", "issue"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "issue": { "type": "string" },
        "resolution": { "type": "string" }
      }
    },
    "resource_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Resources（locator 可为 URL/文件路径）；原行为为 MD 列表；Why: 资源定位可机器消费。",
      "required": ["id", "locator"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "locator": { "type": "string" }
      }
    },
    "visual_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Visual/Browser Findings（Rule 71.3）；原行为为 MD 截图叙述；Why: source 必填约束同 Research Findings。",
      "required": ["id", "finding", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "finding": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "understanding": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: 理解草稿四栏（Rule 28.2.2），original 按 markdown 原文存储；原行为为 MD 文本块；Why: 规划面进权威源。所有键可选，草稿可为空对象。",
      "additionalProperties": false,
      "properties": {
        "original": { "type": "string" },
        "model": { "type": "string" },
        "options": { "type": "string" },
        "direction": { "type": "string" }
      }
    },
    "root_cause_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: 根源覆盖表五列（Rule 53.1）；原行为在 MD 表格；Why: 每根因可核对 VC。",
      "required": ["id", "process", "defect", "fix"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "process": { "type": "string" },
        "defect": { "type": "string" },
        "fix": { "type": "string" },
        "vc": { "type": "string" }
      }
    },
    "invariant_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: 不变量四列（Rule 73.3）；原行为为 MD 表格；Why: 状态-项-锚可校验。",
      "required": ["id", "state", "item", "anchor"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "type": "string" },
        "item": { "type": "string" },
        "anchor": { "type": "string" }
      }
    },
    "spec_baseline_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: 规范基线（Rule 51.15），verbatim 存原文引用；原行为为 MD 引文；Why: sha/anchor 使漂移可检出。",
      "required": ["id", "verbatim", "anchor"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "verbatim": { "type": "string" },
        "anchor": { "type": "string" },
        "rule": { "type": "string" },
        "sha": { "type": "string" }
      }
    },
    "progress_baseline_item": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: 进度产出基线（Rule 111）；原行为为 MD 快照表；Why: ban/status 供防倒退终检读取。",
      "required": ["id", "item", "snapshot"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "item": { "type": "string" },
        "snapshot": { "type": "string" },
        "metric": { "type": "string" },
        "ban": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "config_obj": {
      "type": "object",
      "description": "[2026-11-22 task-jsonderive-deploy-20261122] What: Code Review/会话配置；原行为为散落的脚本参数；Why: 声明为自由扩展对象（不设 additionalProperties:false），兼容未来配置项。",
      "properties": {
        "code_review": { "type": "string" },
        "session_id": { "type": "string" },
        "worktree_path": { "type": "string" },
        "scope_files": { "type": "array", "items": { "type": "string" } }
      }
